========================================
TEST C: Nested call A -> B -> C
========================================

FRAME CREATE  id=1 depth=0
  method: LA;->main ()V
  register count: 4 (locals=4 ins=0 outs=2)
  incoming []
  locals [(empty)]
  outgoing [(empty)]

--- A calls B.add(3, 5) ---
INVOKE  LB;->add (II)I
  args [a0=3, a1=5]
FRAME CREATE  id=2 depth=1
  method: LB;->add (II)I
  register count: 4 (locals=2 ins=2 outs=2)
  incoming [p0=3, p1=5]
  locals [(empty)]
  outgoing [(empty)]
  PASS: B: arg a == 3 (3 == 3)
  PASS: B: arg b == 5 (5 == 5)

--- B calls C.multiply(8, 2) ---
INVOKE  LC;->multiply (II)I
  args [a0=8, a1=2]
FRAME CREATE  id=3 depth=2
  method: LC;->multiply (II)I
  register count: 4 (locals=2 ins=2 outs=1)
  incoming [p0=8, p1=2]
  locals [(empty)]
  outgoing [(empty)]
  PASS: C: arg a == 8 (8 == 8)
  PASS: C: arg b == 2 (2 == 2)

--- C returns to B ---
RETURN  LC;->multiply  value=16
  PASS: C return value == 16 (16 == 16)
  PASS: B: local[0] (sum) still == 8 after C call (8 == 8)

--- B returns to A ---
RETURN  LB;->add  value=16
  PASS: B return value == 16 (16 == 16)
  PASS: A: v0 == 3 (uncorrupted) (3 == 3)
  PASS: A: v1 == 5 (uncorrupted) (5 == 5)
  PASS: A: v2 == 999 (uncorrupted) (999 == 999)
  PASS: A: v3 == 16 (return value) (16 == 16)

=== FRAME STACK DUMP (depth=1) ===
[0] id=1 LA;->main  regs=4  ins=0  locals=4  outs=2
=== END DUMP ===

RETURN  LA;->main  value=void


